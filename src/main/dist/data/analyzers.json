{
  "analysis" : {
    "filter" : {
      "stemmer_filter" : {
        "name" : "english",
        "type" : "stemmer"
      },
      "stop_filter" : {
        "type" : "stop",
        "stopwords" : [
          "the",
          "of",
          "in"
        ]
      },
      "ngram_filter" : {
        "min_gram" : "2",
        "type" : "edge_ngram",
        "max_gram" : "15"
      },
      "truncate_filter" : {
        "type" : "truncate",
        "length" : "15"
      },
      "symbol_word_delimiter" : {
        "type" : "word_delimiter_graph",
        "split_on_case_change" : true,
        "split_on_numerics" : true,
        "generate_word_parts" : true,
        "generate_number_parts" : true,
        "catenate_words" : true,
        "catenate_numbers" : false,
        "catenate_all" : false,
        "preserve_original" : true,
        "stem_english_possessive" : false
      }
    },
    "analyzer" : {
      "ngram_analyzer" : {
        "filter" : [
          "lowercase"
        ],
        "tokenizer" : "my_tokenizer"
      },
      "english_analyzer" : {
        "type" : "standard",
        "stopwords" : "_english_"
      },
      "author_analyzer" : {
        "filter" : [
          "lowercase",
          "stop_filter"
        ],
        "type" : "custom",
        "tokenizer" : "standard"
      },
      "autocomplete_analyzer" : {
        "filter" : [
          "lowercase",
          "ngram_filter"
        ],
        "type" : "custom",
        "tokenizer" : "whitespace"
      },
      "autocomplete_search_analyzer" : {
        "filter" : [
          "lowercase",
          "truncate_filter"
        ],
        "type" : "custom",
        "tokenizer" : "standard"
      },
      "symbol_analyzer" : {
        "filter" : [
          "lowercase"
        ],
        "type":"custom",
        "tokenizer" : "keyword"
      },
      "symbol_parts_analyzer" : {
        "filter" : [
          "symbol_word_delimiter",
          "flatten_graph",
          "lowercase",
          "ngram_filter"
        ],
        "type" : "custom",
        "tokenizer" : "whitespace"
      }
    },
    "tokenizer" : {
      "my_tokenizer" : {
        "type" : "ngram",
        "min_gram" : "3",
        "max_gram" : "4"
      }
    }
  }
}